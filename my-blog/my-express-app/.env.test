# Змінні середовища для інтеграційних тестів.
# База — з docker-compose.test.yml (порт 5433, щоб не конфліктувати
# з локальним/продакшн PostgreSQL на 5432).
DATABASE_URL="postgresql://postgres:password@localhost:5433/blog_test?schema=public"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="integration-test-secret"
PORT=5051

# Об'єктне сховище для тестів (MinIO з docker-compose.test.yml)
S3_ENDPOINT="http://localhost:9100"
S3_BUCKET="blog-media-test"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9100/blog-media-test"
