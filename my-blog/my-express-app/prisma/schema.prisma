generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  posts     Post[]
  comments  Comment[]
  media     Media[]
  createdAt DateTime  @default(now())
}

// Файл, завантажений в об'єктне сховище (R2 / MinIO).
// У базі тримаємо тільки метадані — сам файл лежить у бакеті.
model Media {
  id        Int      @id @default(autoincrement())
  // Ключ об'єкта в бакеті: за ним видаляємо файл зі сховища
  key       String   @unique
  url       String
  mimeType  String
  size      Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  published Boolean   @default(false)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  // Обкладинка поста. SetNull, а не Cascade: видалення картинки
  // не має тягнути за собою сам пост.
  image     Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId   Int?
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
